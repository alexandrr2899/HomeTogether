# Copia local: .env (ignorado por Git; permisos 0600)
HT_DJANGO_SECRET_KEY=
HT_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Solo si Cloudflare Access protege Home Assistant.
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=

# Listas existentes verificadas en Home Assistant.
HT_LIST_COMPRAS_ENTITY_ID=todo.shopping_list_ordcast
HT_LIST_SUPER_ENTITY_ID=todo.famordcast_gmail_com_super
HT_LIST_TASKS_ENTITY_ID=todo.famordcast_gmail_com_to_do_list

# Google Calendar: configuración OAuth del servidor; no enviarla al navegador.
HT_GOOGLE_CLIENT_ID=
HT_GOOGLE_CLIENT_SECRET=
HT_GOOGLE_REFRESH_TOKEN=
HT_GOOGLE_CALENDAR_ID=
HT_GOOGLE_REDIRECT_URI=http://127.0.0.1:8005/api/v1/calendar/oauth/callback/

# Jaime: dejar vacío hasta verificar el Gateway de OpenClaw en mewtwo.
HT_OPENCLAW_URL=
HT_OPENCLAW_TOKEN=
HT_OPENCLAW_AGENT_ID=jaime
